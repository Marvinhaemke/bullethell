{
  "name": "bullet-hell-boss-rush",
  "version": "1.0.0",
  "description": "A canvas bullet-hell boss rush: five bosses, twenty algorithmically generated patterns, five difficulty modes and three life modes.",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "python3 serve.py",
    "build": "python3 build.py",
    "lint": "eslint src tools",
    "test": "node tools/smoke.mjs",
    "audio": "node tools/audiokeys.mjs",
    "survive": "node tools/survivable.mjs",
    "margins": "node tools/survivable.mjs --sweep",
    "difficulty": "node tools/difficulty.mjs",
    "census": "node tools/census.mjs",
    "shots": "node tools/shots.mjs",
    "deadzones": "node tools/safespots.mjs",
    "autopsy": "node tools/autopsy.mjs",
    "ships": "node tools/ships.mjs",
    "bot": "node tools/botbench.mjs",
    "music": "node tools/music.mjs",
    "vercel-build": "node tools/vercel-build.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=18"
  }
}
